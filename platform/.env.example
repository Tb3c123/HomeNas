# === 1. KANBOARD (Shared Message Bus) ===
KANBOARD_URL=http://kanboard/jsonrpc.php
KANBOARD_API_USER=jsonrpc
KANBOARD_API_TOKEN=replace_with_kanboard_api_token
KANBOARD_PROJECT_ID=1
KANBOARD_BACKUP_DIR=/mnt/disk2/Backups/kanboard

# === 2. TELEGRAM WATCHDOG BOT ===
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# === 3. HARDWARE & THERMAL THRESHOLDS (Morefine N6 + Acasis 2x10TB) ===
DISK1_BY_ID=/dev/disk/by-id/ata-WDC_WD102KRYZ-01A5AB0_replace_serial
DISK2_BY_ID=/dev/disk/by-id/ata-WDC_WD101PURP-74B5BY0_replace_serial
HDD_WARN_C=60
HDD_CRIT_C=65
HDD_RECOVERY_C=55
CPU_WARN_C=88
CPU_CRIT_C=92
CPU_OVERLOAD_PCT=95
CPU_LOAD5_MAX=4.0

# === 4. CONTAINER SAFETY LISTS ===
DOCKER_HOST=tcp://docker-proxy:2375
PROTECTED_CONTAINERS=adguard-home,portainer,casaos,kanboard,homenas-watchdog,antigravity-cli
STOPPABLE_CONTAINERS=qbittorrent,jellyfin,radarr,sonarr,bazarr

# === 5. MEDIA & ARR STACK ===
QBIT_URL=http://qbittorrent:8080
QBIT_USER=admin
QBIT_PASS=replace_with_qbit_password
RADARR_URL=http://radarr:7878
RADARR_API_KEY=replace_with_radarr_key
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=replace_with_sonarr_key
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=replace_with_bazarr_key
MIN_DL_SPEED_KBPS=500
MAX_ACTIVE_DOWNLOADS=1

# === 6. DIRECT CLOUD FETCH (Option C: Fshare / Google Drive / TeraBox) ===
# Note: Fshare closed public developer API. You can paste browser direct links
# (https://download*.fshare.vn/dl/...) directly to Elena, or optionally set web cookies:
FSHARE_COOKIE=
TERABOX_COOKIE=
GDRIVE_RCLONE_REMOTE=

# === 7. DEV STUDIO MCP PLUGINS (Context7 / GitHub / SQLite-RO / Playwright) ===
GITHUB_PERSONAL_ACCESS_TOKEN=
PLAYWRIGHT_MCP_URL=http://playwright-mcp:8931/mcp
